# ============================================================================
# KMI-30 Alpha v4.0 - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in the values

# API Configuration
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
PORT=3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (PostgreSQL recommended for production)
# Local: postgresql://postgres:password@localhost:5432/kmi_30_dev
# Docker: postgresql://postgres:password@db:5432/kmi_30_dev
DATABASE_URL=postgresql://user:password@localhost:5432/kmi_30_dev

# Authentication
JWT_SECRET=generate-a-secure-random-string
JWT_EXPIRATION=24h

# AI & Machine Learning
# Get API key from: https://ai.google.dev/
GEMINI_API_KEY=AIzaSyBeF_3PF7MZW2Rb3KbCbBQz6PzdTsYo0ps
GEMINI_MODEL=gemini-1.5-flash

# Data Sources
PSX_API_URL=http://localhost:8000/api/prices
PSXDATA_API_URL=https://api.psxdata.com

# News
# Get API key from: https://newsapi.org/
NEWS_API_KEY=fcd4e24e6dca42cba9ad31d2fa9389ad

# External APIs
IMF_API_URL=https://www.imfconnect.imf.org/api

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_SCRAPER=true
ENABLE_ML_TRAINING=false
ENABLE_GEMINI_MEMOS=true
ENABLE_SHARIAH_AUDIT=true

# ============================================================================
# Optional: RabbitMQ/Redis for async processing
# ============================================================================
REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
